# Slotbook environment configuration. Copy to .env and fill in.
# All values below are placeholders only.

# Primary database connection (PostgreSQL 15+). Used by app, migrations, seed, and tests.
DATABASE_URL=postgres://slotbook:slotbook@localhost:5432/slotbook

# Secret used to sign the demo host session cookie and management state.
# Generate with: openssl rand -hex 32
APP_SECRET=replace-with-a-long-random-hex-string

# Optional passphrase for the demo host dashboard login.
DEMO_HOST_PASSWORD=slotbook-demo

# Public base URL (used to build absolute booking links in notifications/outbox).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port the Next.js dev server listens on.
PORT=3000
